# 사이트 도메인 (배포 후 실제 URL로 변경)
NEXT_PUBLIC_SITE_URL=https://tianxia.co.kr

# Resend API 키 (https://resend.com 에서 발급)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 문의 메일 수신 주소 (기본값: hyuun0724@gmail.com)
CONTACT_RECEIVER_EMAIL=hyuun0724@gmail.com

# 발신자 주소 (Resend에서 도메인 인증 후 변경 가능)
# 도메인 인증 전: onboarding@resend.dev (테스트 전용)
# 도메인 인증 후: noreply@tianxia.co.kr
CONTACT_FROM_EMAIL=onboarding@resend.dev

# PostgreSQL 연결 문자열 (Railway에서 PostgreSQL 추가 시 자동 제공)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 관리자 페이지 비밀번호 (/admin 접속 시 사용)
ADMIN_PASSWORD=your-admin-password

# JWT 서명 시크릿 (랜덤 문자열 32자 이상 권장)
ADMIN_JWT_SECRET=your-random-secret-string-here
